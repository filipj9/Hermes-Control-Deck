NODE_ENV=production
CONTROL_SERVER_HOST=127.0.0.1
CONTROL_SERVER_PORT=4240
CONTROL_ADAPTER_DEADLINE_MS=2500
CONTROL_ADAPTER_READ_DEADLINE_MS=7000
CONTROL_CACHE_TTL_MS=1200
CONTROL_AUTH_TOKEN=generate-a-long-random-token
CONTROL_ALLOWED_ORIGINS=
CONTROL_MAX_BODY_BYTES=262144
CONTROL_MAX_PROMPT_CHARS=100000
CONTROL_RATE_LIMIT_WINDOW_MS=60000
CONTROL_RATE_LIMIT_MAX=120
CONTROL_WEB_HOST=127.0.0.1
CONTROL_WEB_PORT=4241
CONTROL_WEB_PUSH_ENABLED=false
CONTROL_WEB_PUSH_PUBLIC_KEY=
CONTROL_WEB_PUSH_PRIVATE_KEY=
CONTROL_WEB_PUSH_SUBJECT=https://github.com/your-name/Hermes-Control-Deck
CONTROL_WEB_PUSH_TTL_SECONDS=3600
CONTROL_WEB_PUSH_MAX_SUBSCRIPTIONS=10
CONTROL_WEB_PUSH_STATE_FILE=data/web-push-subscriptions.json

HERMES_ENABLED=true
HERMES_BASE_URL=http://127.0.0.1:8787
HERMES_AUTH_MODE=password
HERMES_PASSWORD=
HERMES_API_PREFIX=/api
HERMES_PROFILE=default
HERMES_MODEL=
HERMES_TIMEOUT_MS=10000
HERMES_STREAM_TIMEOUT_MS=0
HERMES_STREAM_RECONNECT_ATTEMPTS=3
HERMES_STREAM_RECONNECT_BACKOFF_MS=250
HERMES_MAX_PROMPT_CHARS=100000

# Optional WebSocket connection to a Hermes Gateway/TUI session.
HERMES_WS_ENABLED=false
HERMES_WS_URL=
HERMES_WS_AUTH_BASE_URL=
HERMES_WS_AUTH_PROVIDER=basic
HERMES_WS_USERNAME=
HERMES_WS_PASSWORD=
HERMES_WS_SESSION_ID=
HERMES_WS_REQUEST_TIMEOUT_MS=15000
HERMES_WS_RECONNECT=true
HERMES_WS_RECONNECT_BACKOFF_MS=1000
HERMES_WS_RECONNECT_MAX_BACKOFF_MS=15000

# Optional local relay. It lets a terminal TUI and the Deck share one upstream
# Hermes Gateway session. Keep it disabled unless the upstream is configured.
HERMES_TUI_RELAY_ENABLED=false
HERMES_TUI_RELAY_PATH=/api/tui-relay
HERMES_TUI_RELAY_CLIENT_WS_URL=
HERMES_TUI_RELAY_TOKEN=
HERMES_TUI_RELAY_UPSTREAM_WS_URL=
HERMES_TUI_RELAY_UPSTREAM_AUTH_BASE_URL=
HERMES_TUI_RELAY_UPSTREAM_AUTH_PROVIDER=basic
HERMES_TUI_RELAY_UPSTREAM_USERNAME=
HERMES_TUI_RELAY_UPSTREAM_PASSWORD=
HERMES_TUI_RELAY_UPSTREAM_SESSION_ID=
HERMES_TUI_RELAY_MAX_MESSAGE_BYTES=1048576
HERMES_TUI_RELAY_MAX_TRACKED_SESSIONS=50

# Optional approval-event bridge plugin transport. This is independent from
# the WebUI password and from CONTROL_AUTH_TOKEN.
HERMES_BRIDGE_ENABLED=false
HERMES_BRIDGE_TOKEN=
HERMES_BRIDGE_MAX_BODY_BYTES=16384
HERMES_BRIDGE_MAX_EVENT_IDS=2000
HERMES_BRIDGE_MAX_TRACKED_RUNS=1000
HERMES_BRIDGE_MAX_TERMINAL_APPROVALS=50
HERMES_BRIDGE_STATE_FILE=

# The legacy WebUI approval scan is off by default. Enable it only when the
# installed Hermes WebUI exposes the compatible approval endpoints.
HERMES_EXTERNAL_APPROVAL_MONITOR_ENABLED=false
HERMES_EXTERNAL_APPROVAL_POLL_MS=2500
HERMES_EXTERNAL_SESSION_LIMIT=50
HERMES_EXTERNAL_SESSION_REFRESH_MS=2000

CODEX_ENABLED=true
CODEX_MODE=cli
CODEX_SURFACE=cli
CODEX_PROFILE=default
CODEX_MODEL=
CODEX_EXECUTABLE=
CODEX_WORKDIR=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request
CODEX_RUN_TIMEOUT_MS=1800000
CODEX_STOP_TIMEOUT_MS=5000
CODEX_ALLOW_CONCURRENT_RUNS=false
CODEX_MAX_PROMPT_CHARS=100000
CODEX_MIN_VERSION=

# Optional, unofficial Windows-only Codex Desktop integration. This add-on is
# disabled by default and may break after any Codex Desktop update. It never
# launches, restarts, or terminates Codex Desktop automatically.
CODEX_EXPERIMENTAL_DESKTOP_ENABLED=false
CODEX_EXPERIMENTAL_DESKTOP_CDP_HOST=127.0.0.1
CODEX_EXPERIMENTAL_DESKTOP_CDP_PORT=4248
CODEX_EXPERIMENTAL_DESKTOP_REQUEST_TIMEOUT_MS=6000
CODEX_EXPERIMENTAL_DESKTOP_CODEX_HOME=
CODEX_EXPERIMENTAL_DESKTOP_STATE_FILE=

EVENT_STORE_DRIVER=memory
