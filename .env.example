NODE_ENV=production
CONTROL_SERVER_HOST=127.0.0.1
CONTROL_SERVER_PORT=4240
CONTROL_ADAPTER_DEADLINE_MS=2500
CONTROL_ADAPTER_READ_DEADLINE_MS=7000
CONTROL_CACHE_TTL_MS=1200
CONTROL_AUTH_TOKEN=generate-a-long-random-token
CONTROL_ALLOWED_ORIGINS=
CONTROL_MAX_BODY_BYTES=262144
CONTROL_MAX_PROMPT_CHARS=100000
CONTROL_RATE_LIMIT_WINDOW_MS=60000
CONTROL_RATE_LIMIT_MAX=120
CONTROL_WEB_HOST=127.0.0.1
CONTROL_WEB_PORT=4241

HERMES_ENABLED=true
HERMES_BASE_URL=http://127.0.0.1:8787
HERMES_AUTH_MODE=password
HERMES_PASSWORD=
HERMES_API_PREFIX=/api
HERMES_PROFILE=default
HERMES_MODEL=
HERMES_TIMEOUT_MS=10000
HERMES_STREAM_TIMEOUT_MS=0
HERMES_MAX_PROMPT_CHARS=100000

CODEX_ENABLED=true
CODEX_MODE=cli
CODEX_SURFACE=cli
CODEX_PROFILE=default
CODEX_MODEL=
CODEX_EXECUTABLE=
CODEX_WORKDIR=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request
CODEX_RUN_TIMEOUT_MS=1800000
CODEX_STOP_TIMEOUT_MS=5000
CODEX_ALLOW_CONCURRENT_RUNS=false
CODEX_MAX_PROMPT_CHARS=100000
CODEX_MIN_VERSION=

EVENT_STORE_DRIVER=memory
